rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 🛡️ Security Helpers ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      // Admin mapping based on AuthContext logic
      return isAuthenticated() && (
        request.auth.token.email == 'admin@easternvacations.com' ||
        request.auth.token.email == 'manu@easternvacations.com'
      );
    }

    function isAgent() {
      return isAuthenticated() && request.auth.token.email.matches('.*@easternvacations.com');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- 📦 CORE BUSINESS DATA ---

    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (resource.data.createdById == request.auth.token.email);
    }

    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // UPDATED: Allow authorized users to link their newly created UID to their personnel record
    match /drivers/{driverId} {
      allow read: if true; 
      allow create: if isAuthenticated() && request.auth.uid == driverId;
      allow update: if isAdmin() || (isAuthenticated() && (
        request.auth.token.email.lower() == resource.data.get('email', '').lower() ||
        request.auth.token.email.lower() == resource.data.get('personalEmail', '').lower() ||
        !('uid' in resource.data) ||
        resource.data.uid == "" ||
        resource.data.uid == request.auth.uid ||
        request.auth.uid == driverId
      ));
      allow delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true; // Publicly viewable for booking
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read, write: if isAuthenticated();
    }

    // --- 🚛 FLEET MANAGEMENT EXTENSION (STAFF PWA) ---

    match /driverAuth/{driverId} {
      // Drivers can read/write their own registration profile
      allow read: if isAdmin() || isOwner(driverId);
      allow create: if isAuthenticated(); 
      allow update: if isAdmin() || isOwner(driverId);
      allow delete: if isAdmin();
    }

    match /porters/{porterId} {
      // Admins and Drivers can manage assigned porters
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (resource.data.driverId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /driverLocations/{driverId} {
      // Real-time location tracking: Driver writes, Admin reads
      allow read: if isAdmin();
      allow write: if isOwner(driverId);
    }

    match /sosAlerts/{alertId} {
      // SOS flow: Driver triggers, Admin acknowledges/resolves
      allow read: if isAdmin() || (resource.data.driverId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin(); 
      allow delete: if isAdmin();
    }

    match /tripUpdates/{updateId} {
      // Operational logging
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /driverMessages/{driverId} {
      // Chat Hub: Root metadata document
      allow read, write: if request.auth != null && (
        request.auth.uid == driverId || isAgent()
      );
      
      match /messages/{messageId} {
        // Individual messages in the thread
        allow read, write: if request.auth != null && (
          request.auth.uid == driverId || isAgent()
        );
      }
    }

    // --- ☁️ WEATHER INTELLIGENCE MODULE ---

    match /weatherData/{parkId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /weatherAdvisories/{parkId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /weatherAlerts/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /weatherHistory/{parkId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /parks/{parkId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- 🔒 DEFAULT DENY ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
