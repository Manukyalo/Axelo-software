rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isAgent() {
      return isAuthenticated() && request.auth.token.role == 'agent';
    }

    function isDriver() {
      return isAuthenticated() && request.auth.token.role == 'driver';
    }

    // --- 🚨 KILL SWITCH LOGIC ---
    function isSystemLocked() {
      return get(/databases/$(database)/documents/system_config/emergency).data.locked == true;
    }

    function canAccess() {
      return isAdmin() || (isAuthenticated() && !isSystemLocked());
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- ⚙️ SYSTEM CONFIG ---
    match /system_config/{doc} {
      allow read: if true; // Publicly readable so guards work before login
      allow write: if isAdmin();
    }

    // --- 📦 CORE BUSINESS DATA ---

    match /bookings/{bookingId} {
      allow read: if canAccess();
      // Only Admins and Agents can create bookings
      allow create: if canAccess() && (isAdmin() || isAgent());
      allow update: if isAdmin() || (canAccess() && (isAgent() && (
        resource.data.createdById == request.auth.token.email || 
        resource.data.createdById == request.auth.uid
      )));
      allow delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if canAccess();
      allow write: if isAdmin();
    }

    match /drivers/{driverId} {
      // Prevent drivers from listing all other drivers. Agents and Admins can see all.
      allow read: if canAccess() && (isAdmin() || isAgent() || isOwner(driverId)); 
      allow create: if canAccess() && (isAdmin() || isAgent() || isOwner(driverId));
      allow update: if isAdmin() || (canAccess() && (
        isOwner(driverId) ||
        request.auth.token.email.lower() == resource.data.get('email', '').lower() ||
        request.auth.token.email.lower() == resource.data.get('personalEmail', '').lower()
      ));
      allow delete: if isAdmin();
    }

    match /driverAuth/{userId} {
      allow read: if canAccess() && (isOwner(userId) || isAdmin() || isAgent());
      allow create: if canAccess() && (isOwner(userId) || isAdmin());
      allow update: if canAccess() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /porters/{porterId} {
      allow read: if canAccess() && (isOwner(porterId) || isAdmin() || isAgent());
      allow create: if canAccess() && (isOwner(porterId) || isAdmin());
      allow update: if canAccess() && (isOwner(porterId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if canAccess() && (isAdmin() || isAgent() || isOwner(staffId));
      allow create: if isAdmin();
      allow update: if isAdmin() || (canAccess() && isOwner(staffId));
      allow delete: if isAdmin();
    }

    // --- 🔒 FACE ID / BIOMETRICS ---

    match /faceDescriptors/{userId} {
      allow read: if canAccess() && (isOwner(userId) || isAdmin());
      allow create: if canAccess() && (isOwner(userId) || isAdmin());
      allow update: if canAccess() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /biometrics/{userId} {
      allow read: if canAccess() && (isOwner(userId) || isAdmin());
      allow create: if canAccess() && (isOwner(userId) || isAdmin());
      allow update: if canAccess() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true; // Publicly available for customers
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if canAccess() && (resource.data.targetRole == 'both' || resource.data.targetRole == 'admin' || isAgent() || isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if canAccess();
      allow update, delete: if isAdmin();
    }

    // --- 🚛 FLEET MANAGEMENT ---

    match /driverLocations/{driverId} {
      allow read: if canAccess(); // Agents/Admins need this for LiveTracking
      allow write: if isAdmin() || (canAccess() && isOwner(driverId));
    }

    match /sosAlerts/{alertId} {
      allow read: if canAccess() && (isAgent() || isAdmin());
      allow create: if canAccess();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /driverMessages/{driverId} {
      allow read, write: if canAccess() && (
        request.auth.uid == driverId || isAgent() || isAdmin()
      );
      
      match /messages/{messageId} {
        allow read, write: if canAccess() && (
          request.auth.uid == driverId || isAgent() || isAdmin()
        );
      }
    }

    // --- ☁️ WEATHER ---

    match /weather_intelligence/{parkId} {
      allow read: if canAccess();
      allow write: if isAdmin();
    }

    match /weatherAlerts/{doc} {
      allow read: if canAccess();
      allow write: if isAdmin();
    }

    // --- 🔒 DEFAULT DENY ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
